# Copy this file to .env and fill in the values. Never commit .env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=prayonit-social-backgrounds

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

BUFFER_API_KEY=
BUFFER_FACEBOOK_CHANNEL_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=
BUFFER_THREADS_CHANNEL_ID=

# Optional Threads post metadata (Buffer GraphQL ThreadsPostMetadataInput).
# Leave blank to omit the field from the Buffer payload entirely.
THREADS_LOCATION_NAME=United States of America
THREADS_LOCATION_ID=

# Keep true for the first run. Change to false only after reviewing the image.
TEST_MODE=true
POST_TYPE=download-focused morning ad
OUTPUT_DIR=output
BACKGROUND_PREFIX=
GENERATED_PREFIX=generated

# ---------- Tracked links (Layer 1) ----------
# TRACKING_ENABLED=false uses DEFAULT_DESTINATION_URL directly in captions
# (no /download or ?t= suffix), since the Layer 2 redirect Edge Function is
# not deployed by default and would otherwise 404. Tracking IDs are still
# generated and stored locally either way. Set to true only after deploying
# supabase/functions/track-download (see docs/TRACKING.md).
TRACKING_ENABLED=false
TRACKING_BASE_URL=https://prayonit.nextwavestudiosapp.com
IOS_DESTINATION_URL=
ANDROID_DESTINATION_URL=
DEFAULT_DESTINATION_URL=
TRACKING_SECRET=

# ---------- Buffer metrics ----------
METRICS_COOLDOWN_HOURS=12

# ---------- Non-repetition tuning (optional; defaults shown) ----------
HISTORY_BACKGROUND_DAYS=30
HISTORY_HEADLINE_DAYS=90
HISTORY_CAMPAIGN_RUNS=3
HISTORY_FORMULA_RUNS=2
HISTORY_PERSONA_RUNS=2
HISTORY_CAMPAIGN_FORMULA_DAYS=30

