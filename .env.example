# Copy this file to .env and fill in the values. Never commit .env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=prayonit-social-backgrounds

# Legacy/backward-compatible option. Prefer GEMINI_API_KEY_PRIMARY instead.
GEMINI_API_KEY=
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_SECONDARY=
GEMINI_MODEL=gemini-2.5-flash
CONTENT_MODEL_PRIMARY=gemini-3.6-flash
CONTENT_MODEL_SECONDARY=gemini-2.5-flash
CONTENT_MODEL_TERTIARY=gemini-3.5-flash-lite
VOICE_MODEL_PRIMARY=gemini-3.1-flash-tts-preview
VOICE_MODEL_SECONDARY=gemini-2.5-flash-preview-tts
VOICE_NAME_PRAYER=Orus
VOICE_NAME_DEVOTIONAL=Orus
VOICE_NAME_ENCOURAGEMENT=Orus
VOICE_NAME_ALTERNATE=Charon
VOICE_TEMPERATURE=1

BUFFER_API_KEY=
BUFFER_FACEBOOK_CHANNEL_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=
BUFFER_TIKTOK_CHANNEL_ID=

# Video delivery: all three destinations are scheduled automatically through Buffer.
SOCIAL_OUTPUT_MODE=reels_only
VIDEO_PUBLISH_ENABLED=false
# Set true only when the TikTok publishing strategy explicitly uses this text.
TIKTOK_INCLUDE_LINK_IN_BIO=false
# Deprecated/unused: Threads publishing is no longer active.
BUFFER_THREADS_CHANNEL_ID=

# Deprecated/unused: Threads metadata is no longer active.
THREADS_LOCATION_NAME=United States of America
THREADS_LOCATION_ID=

# Keep true for the first run. Change to false only after reviewing the image.
TEST_MODE=true
# Optional PREVIEW_MODE/TEST_MODE-only caption profile comparison override.
CAPTION_PROFILE_PREVIEW_OVERRIDE=
POST_TYPE=download-focused morning ad
OUTPUT_DIR=output
BACKGROUND_PREFIX=
GENERATED_PREFIX=generated

# ---------- Tracked links (Layer 1) ----------
# TRACKING_ENABLED=false uses DEFAULT_DESTINATION_URL directly in captions
# (no /download or ?t= suffix), since the Layer 2 redirect Edge Function is
# not deployed by default and would otherwise 404. Tracking IDs are still
# generated and stored locally either way. Set to true only after deploying
# supabase/functions/track-download (see docs/TRACKING.md).
TRACKING_ENABLED=false
TRACKING_BASE_URL=https://prayonit.app
IOS_DESTINATION_URL=
ANDROID_DESTINATION_URL=
DEFAULT_DESTINATION_URL=
TRACKING_SECRET=

# ---------- Buffer metrics ----------
METRICS_COOLDOWN_HOURS=12

# ---------- Non-repetition tuning (optional; defaults shown) ----------
HISTORY_BACKGROUND_DAYS=30
HISTORY_HEADLINE_DAYS=90
HISTORY_CAMPAIGN_RUNS=3
HISTORY_FORMULA_RUNS=2
HISTORY_PERSONA_RUNS=2
HISTORY_CAMPAIGN_FORMULA_DAYS=30
